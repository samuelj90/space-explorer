      "name": ".angular",
      "category": "Angular",
      "desc": "Angular CLI cache",
      "safe_to_delete": true,
      "is_dir": true
    }
  ],
  "package_caches": [
    {
      "id": "npm",
      "name": "NPM Cache",
      "category": "JavaScript / Node",
      "desc": "Global tarball cache of downloaded npm packages.",
      "path": "~/.npm",
      "clean_cmd": ["npm", "cache", "clean", "--force"],
      "safe": true
    },
    {
      "id": "yarn",
      "name": "Yarn Cache",
      "category": "JavaScript / Node",
      "desc": "Downloaded yarn packages cache.",
      "path": "~/Library/Caches/Yarn",
      "clean_cmd": ["yarn", "cache", "clean"],
      "safe": true
    },
    {
      "id": "homebrew",
      "name": "Homebrew Cache",
      "category": "Package Manager",
      "desc": "Downloaded formula & bottle tarballs.",
      "path": "~/Library/Caches/Homebrew",
      "clean_cmd": ["brew", "cleanup", "--prune=all"],
      "safe": true,
      "platform_only": "Darwin"
    },
    {
      "id": "cargo",
      "name": "Cargo Registry Cache",
      "category": "Rust",
      "desc": "Downloaded crates.io .crate tarballs.",
      "path": "~/.cargo/registry/cache",
      "clean_cmd": null,
      "safe": true
    },
    {
      "id": "pip",
      "name": "Pip Cache",
      "category": "Python",
      "desc": "Downloaded wheels and source tarballs.",
      "path": "~/Library/Caches/pip",
      "clean_cmd": ["pip", "cache", "purge"],
      "safe": true
    },
    {
      "id": "gradle",
      "name": "Gradle Cache",
      "category": "Java / Android",
      "desc": "Downloaded jars and build transforms.",
      "path": "~/.gradle/caches",
      "clean_cmd": null,
      "safe": true
    },
    {
      "id": "simulators",
      "name": "iOS Simulators",
      "category": "Apple Developer",
      "desc": "Erases cached states of inactive iOS simulator devices.",
      "path": "~/Library/Developer/CoreSimulator/Devices",
      "clean_cmd": ["xcrun", "simctl", "erase", "all"],
      "safe": true,
      "platform_only": "Darwin"
    }
  ]
}
